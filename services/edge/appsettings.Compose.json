{
  "Auth": {
    "Mode": "compose-dev",
    "Authority": "http://dev-idp:4000",
    "Audience": "api://ai-gateway-edge"
  },
  "Downstream": {
    "DevIdpUrl": "http://dev-idp:4000",
    "M2mAudience": "api://llm-gateway-internal",
    "YarpAppId": "yarp-compose-dev",
    "M2mScope": "api://llm-gateway-internal/.default"
  },
  "ReverseProxy": {
    "Routes": {
      "chat": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/v1/chat/completions" }
      },
      "messages": {
        "ClusterId": "gateway",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/v1/messages" }
      },
      "health": { "ClusterId": "gateway", "Match": { "Path": "/health" } },
      "ready": { "ClusterId": "gateway", "Match": { "Path": "/ready" } }
    },
    "Clusters": {
      "gateway": { "Destinations": { "d1": { "Address": "http://gateway:3000/" } } }
    }
  }
}
