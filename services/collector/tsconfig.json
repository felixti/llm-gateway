{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": { "@shared/*": ["../../packages/shared/src/*"] },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"]
}
