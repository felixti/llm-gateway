# Host-native development — environment template
#
# Copy and load before running services on your machine (outside Docker):
#   cp deploy/local/.env.example deploy/local/.env
#   set -a && source deploy/local/.env && set +a
#
# Start backing services first:
#   docker compose -f deploy/compose/docker-compose.yml up -d redis azurite dev-idp
#
# Then in separate terminals:
#   cd services/gateway && yarn install && yarn build && node dist/server.js
#   cd services/collector && yarn install && yarn build && node dist/server.js
#   cd services/edge && dotnet run
#
# See deploy/local/README.md for the full recipe.

# --- Host endpoints (services on localhost, infra in Docker) ------------------

PORT=3000
REDIS_URL=redis://127.0.0.1:6379

# Azurite on published compose ports (127.0.0.1, not docker service names)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

USAGE_QUEUE=azure
USAGE_QUEUE_NAME=usage-events
WAL_DIR=/tmp/ai-gateway-wal
WAL_REPLAY_INTERVAL_MS=60000

CONFIG_STORE=memory
# CONFIG_STORE=table
# AZURE_TABLE_CONNECTION_STRING=${AZURE_STORAGE_CONNECTION_STRING}
# CONFIG_TABLE_NAME=aigatewayconfig

# dev-idp published on host (compose DEV_IDP_PORT)
M2M_JWKS_URL=http://127.0.0.1:4000/keys
M2M_EXPECTED_ISSUER=http://127.0.0.1:4000
M2M_EXPECTED_AUDIENCE=api://llm-gateway-internal
M2M_EXPECTED_APPID=yarp-compose-dev
TENANCY_DEFAULT_ORG=internal

RATE_LIMIT_RPM=1000
RATE_LIMIT_TPM=1000000
BUDGET_RESERVATION_TTL_SEC=300
BUDGET_RESERVE_MULTIPLIER=1.2
BUDGET_COMMIT_IDEMPOTENCY_TTL_SEC=604800

# --- Collector (host) ---------------------------------------------------------

COLLECTOR_PORT=4100
COLLECTOR_OUT_DIR=./.local/collector-out
COLLECTOR_POLL_INTERVAL_MS=5000
COLLECTOR_BATCH_SIZE=32
COLLECTOR_WORKER_ENABLED=true

# --- Edge (host — dotnet run) -------------------------------------------------

ASPNETCORE_ENVIRONMENT=Compose
ASPNETCORE_URLS=http://127.0.0.1:8080
Auth__Mode=compose-dev
Auth__Authority=http://127.0.0.1:4000
Auth__Audience=api://ai-gateway-edge
Downstream__DevIdpUrl=http://127.0.0.1:4000
Downstream__M2mAudience=api://llm-gateway-internal
Downstream__YarpAppId=yarp-compose-dev

# Gateway cluster destination when edge runs on host
# (Program.cs / appsettings.Compose.json — gateway on localhost:3000)

# =============================================================================
# Azure production — fill when connecting to real upstream (optional locally)
# =============================================================================

# AZURE_ENTRA_TENANT_ID=
# AZURE_ENTRA_CLIENT_ID=
# AZURE_ENTRA_CLIENT_SECRET=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_AI_FOUNDRY_ENDPOINT=
# AZURE_AI_FOUNDRY_KEY=
