# =============================================================================
# AI Gateway — local compose environment
# =============================================================================
# Copy to .env and adjust only what you need:
#   cp deploy/compose/.env.example deploy/compose/.env
#
# Defaults below run the full MVP stack locally with NO Azure account:
#   dev-idp (fake Entra) · Redis · Azurite (queue/table) · gateway · edge · collector
#
# Fill the "Azure production" section only when pointing at real Azure OpenAI / Entra.
# =============================================================================

# --- Public ports (host → container) -----------------------------------------

# YARP edge — your API entrypoint
EDGE_PORT=8080

# Optional: expose dev-idp for manual token minting from the host
DEV_IDP_PORT=4000

# Usage collector health + metrics stub
COLLECTOR_PORT=4100

# Azurite (only needed when running infra from compose and services on the host)
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# --- Local emulators (pre-filled — do not change for default compose) ----------

# Azurite well-known dev account (Microsoft documented test key)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# Table Storage config (optional — default is in-memory code seed)
# CONFIG_STORE=table
# AZURE_TABLE_CONNECTION_STRING=${AZURE_STORAGE_CONNECTION_STRING}
# CONFIG_TABLE_NAME=aigatewayconfig

# Usage metering queue (gateway → collector)
USAGE_QUEUE=azure
USAGE_QUEUE_NAME=usage-events

# --- Trust boundary (compose dev-idp — must match edge + gateway) ------------

DEV_IDP_ISSUER=http://dev-idp:4000
M2M_JWKS_URL=http://dev-idp:4000/keys
M2M_EXPECTED_ISSUER=http://dev-idp:4000
M2M_EXPECTED_AUDIENCE=api://llm-gateway-internal
M2M_EXPECTED_APPID=yarp-compose-dev

# Edge (.NET) — mirrored in docker-compose environment
EDGE_AUTH_MODE=compose-dev
EDGE_AUTH_AUTHORITY=http://dev-idp:4000
EDGE_AUTH_AUDIENCE=api://ai-gateway-edge
EDGE_DOWNSTREAM_YARP_APP_ID=yarp-compose-dev

# --- Tenancy seed (M1 in-memory / code seed) ---------------------------------

TENANCY_DEFAULT_ORG=internal

# --- Redis (budget + rate limit) -----------------------------------------------

REDIS_URL=redis://redis:6379

# --- Gateway tuning (generous for local dev) -----------------------------------

RATE_LIMIT_RPM=1000
RATE_LIMIT_TPM=1000000
BUDGET_RESERVATION_TTL_SEC=300
BUDGET_RESERVE_MULTIPLIER=1.2
BUDGET_COMMIT_IDEMPOTENCY_TTL_SEC=604800

# --- Usage pipeline (ADR-0012) -------------------------------------------------

WAL_DIR=/tmp/wal
WAL_REPLAY_INTERVAL_MS=60000
COLLECTOR_OUT_DIR=/data/out
COLLECTOR_POLL_INTERVAL_MS=5000
COLLECTOR_BATCH_SIZE=32
COLLECTOR_WORKER_ENABLED=true

# Real Azure upstream (gateway proxy). Uses stub when unset and no endpoints configured.
# UPSTREAM_MODE=azure
# AZURE_OPENAI_ENDPOINT=https://my-ms-aif.cognitiveservices.azure.com
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_CHAT_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_RESPONSES_API_VERSION=2025-04-01-preview
# AZURE_AI_FOUNDRY_ENDPOINT=https://my-ms-aif.services.ai.azure.com
# AZURE_AI_FOUNDRY_KEY=
# AZURE_FOUNDRY_CHAT_API_VERSION=2024-05-01-preview

# Production M2M (replace dev-idp URLs above when edge validates real Entra):
# M2M_JWKS_URL=https://login.microsoftonline.com/${AZURE_ENTRA_TENANT_ID}/discovery/v2.0/keys
# M2M_EXPECTED_ISSUER=https://login.microsoftonline.com/${AZURE_ENTRA_TENANT_ID}/v2.0
# M2M_EXPECTED_APPID=<yarp-app-registration-client-id>

# Real Azure Storage / ADX (replace Azurite connection string):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# ADX_INGEST_CONNECTION_STRING=
# ADX_DATABASE=Usage
# ADX_TABLE=RawUsage
